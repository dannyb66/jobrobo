{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Company catalog v2 (opt-in, non-executing)",
  "type": "object",
  "required": [
    "schema_version",
    "derived_from",
    "classification_policy",
    "classification_counts",
    "companies"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "derived_from": {
      "type": "object",
      "properties": {
        "path": {
          "const": "data/company_names.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema_version": {
          "const": 1
        }
      },
      "required": [
        "path",
        "sha256",
        "schema_version"
      ],
      "additionalProperties": false
    },
    "classification_policy": {
      "type": "object"
    },
    "classification_counts": {
      "type": "object"
    },
    "companies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "aliases",
          "source_tasks",
          "provenance",
          "classification"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_tasks": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          },
          "classification": {
            "type": "object",
            "properties": {
              "classified_at_utc": {
                "type": "string",
                "format": "date-time"
              },
              "method": {
                "type": "string",
                "enum": [
                  "saved_source_rules_v1",
                  "public_source_review_v1"
                ]
              },
              "industry": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "enum": [
                      "ai_agents",
                      "infrastructure_devtools",
                      "enterprise_software",
                      "fintech",
                      "security",
                      "robotics_industrial",
                      "healthcare",
                      "consumer",
                      "other",
                      "unknown"
                    ]
                  },
                  "confidence": {
                    "type": "string",
                    "enum": [
                      "high",
                      "medium",
                      "low",
                      "unknown"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "source_id": {
                              "type": "string"
                            },
                            "record_pointer": {
                              "type": "string"
                            },
                            "field": {
                              "type": "string",
                              "enum": [
                                "description",
                                "category",
                                "acquisition.note",
                                "roles.title",
                                "ownership_evidence"
                              ]
                            },
                            "source_observed_at": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "excerpt": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "source_id",
                            "record_pointer",
                            "field",
                            "source_observed_at",
                            "excerpt"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "url": {
                              "type": "string",
                              "format": "uri"
                            },
                            "title": {
                              "type": "string"
                            },
                            "excerpt": {
                              "type": "string",
                              "minLength": 1
                            },
                            "checked_at_utc": {
                              "type": "string",
                              "format": "date-time"
                            }
                          },
                          "required": [
                            "url",
                            "title",
                            "excerpt",
                            "checked_at_utc"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "value",
                  "confidence",
                  "evidence",
                  "reason"
                ],
                "additionalProperties": false
              },
              "tech_fit": {
                "type": "object",
                "properties": {
                  "assessment": {
                    "type": "string",
                    "enum": [
                      "domain_overlap_only",
                      "not_assessed",
                      "no_supported_tag"
                    ]
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "string",
                          "enum": [
                            "backend_distributed_systems",
                            "kubernetes_sre",
                            "ai_agents_rag",
                            "full_stack",
                            "ml_infrastructure",
                            "robotics_software"
                          ]
                        },
                        "confidence": {
                          "type": "string",
                          "enum": [
                            "high",
                            "medium",
                            "low"
                          ]
                        },
                        "evidence": {
                          "type": "array",
                          "items": {
                            "anyOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "source_id": {
                                    "type": "string"
                                  },
                                  "record_pointer": {
                                    "type": "string"
                                  },
                                  "field": {
                                    "type": "string",
                                    "enum": [
                                      "description",
                                      "category",
                                      "acquisition.note",
                                      "roles.title",
                                      "ownership_evidence"
                                    ]
                                  },
                                  "source_observed_at": {
                                    "type": [
                                      "string",
                                      "null"
                                    ]
                                  },
                                  "excerpt": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                },
                                "required": [
                                  "source_id",
                                  "record_pointer",
                                  "field",
                                  "source_observed_at",
                                  "excerpt"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "url": {
                                    "type": "string",
                                    "format": "uri"
                                  },
                                  "title": {
                                    "type": "string"
                                  },
                                  "excerpt": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "checked_at_utc": {
                                    "type": "string",
                                    "format": "date-time"
                                  }
                                },
                                "required": [
                                  "url",
                                  "title",
                                  "excerpt",
                                  "checked_at_utc"
                                ],
                                "additionalProperties": false
                              }
                            ]
                          },
                          "minItems": 1
                        }
                      },
                      "required": [
                        "value",
                        "confidence",
                        "evidence"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "assessment",
                  "tags",
                  "reason"
                ],
                "additionalProperties": false
              },
              "status": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "enum": [
                      "research",
                      "qualified_opening_found",
                      "watchlist",
                      "identity_needs_verification",
                      "deprioritized"
                    ]
                  },
                  "scope": {
                    "const": "company_next_action"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "basis_provenance_indices": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "value",
                  "scope",
                  "reason",
                  "basis_provenance_indices"
                ],
                "additionalProperties": false
              },
              "research_review": {
                "type": "object",
                "properties": {
                  "identity": {
                    "type": "string",
                    "enum": [
                      "confirmed",
                      "ambiguous"
                    ]
                  },
                  "rationale": {
                    "type": "string"
                  },
                  "limitations": {
                    "type": "string"
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string",
                          "format": "uri"
                        },
                        "title": {
                          "type": "string"
                        },
                        "excerpt": {
                          "type": "string",
                          "minLength": 1
                        },
                        "checked_at_utc": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "url",
                        "title",
                        "excerpt",
                        "checked_at_utc"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "checked_at_utc": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "identity",
                  "rationale",
                  "limitations",
                  "sources",
                  "checked_at_utc"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "classified_at_utc",
              "method",
              "industry",
              "tech_fit",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
